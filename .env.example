# Orbit platform configuration. `npm run bootstrap` writes a real .env with
# generated secrets (values starting with change-me count as unset); copy this
# file only if you configure things by hand. Docker Compose reads .env as well.

ORBIT_PORT=4000
ORBIT_PUBLIC_URL=http://localhost:4000
ORBIT_PORTAL_URL=http://localhost:5173
# Gitea (a container) calls this on every push. host.docker.internal reaches the host from Docker Desktop.
ORBIT_WEBHOOK_URL=http://host.docker.internal:4000/webhooks/gitea
ORBIT_WEBHOOK_SECRET=change-me-random-hex
ORBIT_DATA_DIR=.orbit-data
# Orbit refuses any kube context not listed in ORBIT_ALLOWED_KUBE_CONTEXTS.
# orbit-compose is the k3s service in docker-compose.yml; kind uses kind-orbit.
ORBIT_KUBE_CONTEXT=orbit-compose
ORBIT_ALLOWED_KUBE_CONTEXTS=orbit-compose
ORBIT_COMPONENTS=api,worker,ci,gitops
ORBIT_ENVIRONMENTS=dev,staging
ORBIT_BASE_DOMAIN=localtest.me
# Host port of the edge proxy; every platform and app URL goes through it.
ORBIT_INGRESS_PORT=8080
# Optional: when set, the API requires "Authorization: Bearer <token>".
ORBIT_API_TOKEN=
# Platform admins send this token instead (portal: Platform page). Only admins can update
# platform versions (Platform → Versions). npm run bootstrap generates it; empty: nobody is admin.
ORBIT_ADMIN_TOKEN=change-me-random-hex

GITEA_URL=http://git.localtest.me:8080
# As seen from pods (CI clones). Pods resolve Compose service names.
GITEA_INTERNAL_URL=http://gitea:3000
GITEA_USER=orbit-admin
GITEA_PASSWORD=change-me
GITEA_TOKEN=change-me-gitea-access-token
GITEA_APPS_ORG=apps
GITEA_GITOPS_REPO=platform/gitops

GRAFANA_URL=http://grafana.localtest.me:8080
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

PROMETHEUS_URL=http://prometheus.localtest.me:8080
# Orbit writes alert rule files here and Prometheus mounts the directory.
# Empty: ConfigMap prometheus-rules instead (kind).
PROMETHEUS_RULES_DIR=./.orbit-data/prometheus-rules

# Pods push to REGISTRY_PUSH; the kubelet pulls from REGISTRY_PULL (a mirror of the same registry).
REGISTRY_PUSH=registry:5000
REGISTRY_PULL=localhost:5001

# Cloud resources for apps (S3 bucket, SQS queue), created by terraform/modules/app-cloud.
#   floci: Floci, the local AWS emulator that bootstrap starts (default)
#   aws:   real AWS; put credentials in Secret orbit-aws-credentials in orbit-system
#          (keys AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
#   none:  disable the S3 and queue options
ORBIT_CLOUD=floci
ORBIT_AWS_REGION=us-east-1
# Bucket and queue names are <prefix>-<app>-<env>. S3 bucket names are global on real AWS.
ORBIT_CLOUD_NAME_PREFIX=orbit
# Floci as seen from the Orbit API on the host (through the edge proxy) and from pods.
FLOCI_URL=http://aws.localtest.me:8080
FLOCI_INTERNAL_URL=http://floci:4566

# Trivy's vulnerability DB (about 135 MB), kept in PVC orbit-scan-cache and shared by every scan.
# Empty repository: Trivy's own default (ghcr.io in Trivy 0.55, often slower).
ORBIT_TRIVY_DB_REPOSITORY=mirror.gcr.io/aquasec/trivy-db:2
ORBIT_TRIVY_DB_TIMEOUT_MINUTES=20

# CI and Terraform tool images. Admins can also change them in the portal (Platform → Versions),
# which takes precedence over these. Defaults: src/config/env.ts.
# ORBIT_IMAGE_TRIVY=aquasec/trivy:0.55.0
# ORBIT_IMAGE_ZAP=zaproxy/zap-stable:2.17.0

# Docker Compose only (docker-compose.yml).
# Network <prefix>.0/24 for the platform containers; change it if it clashes with your networks.
ORBIT_NET_PREFIX=10.213.0
# Gitea's own secrets; generate them once and keep them.
GITEA_SECRET_KEY=change-me-random-hex
GITEA_INTERNAL_TOKEN=change-me-random-hex
