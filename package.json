{
  "name": "orbit-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Orbit internal developer platform: portal, golden-path provisioning, CI/CD, GitOps, security scanning and observability",
  "type": "module",
  "workspaces": [
    "portal"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "orbit": "dist/cli.js"
  },
  "scripts": {
    "dev": "concurrently -k -n api,portal -c blue,magenta \"npm:dev:api\" \"npm:dev:portal\"",
    "dev:api": "tsx watch src/main.ts",
    "dev:portal": "npm run dev -w portal",
    "build": "tsc -p tsconfig.build.json && npm run build -w portal",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && npm run typecheck -w portal",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint . && npm run lint -w portal",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "orbit": "tsx src/cli.ts",
    "bootstrap": "node bootstrap/compose.mjs up",
    "teardown": "node bootstrap/compose.mjs down",
    "bootstrap:kind": "node bootstrap/up.mjs",
    "teardown:kind": "node bootstrap/down.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.0",
    "@kubernetes/client-node": "^1.1.2",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2"
  }
}
