{
  "name": "{{APP_NAME}}",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "build": "babel src --out-dir dist --delete-dir-on-start --source-maps",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "node --watch --require @babel/register src/main.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@prometheus-io/client": "^0.16.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.2",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.1.2",
    "@nestjs/testing": "^12.5.1",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json"],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.js$",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node"
  }
}
