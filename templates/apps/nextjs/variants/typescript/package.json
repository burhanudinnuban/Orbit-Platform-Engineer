    "test": "next typegen && tsc --noEmit && node --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
